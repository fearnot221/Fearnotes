---
import Base from "../../layouts/Base.astro";
import PostGrid from "../../components/PostGrid.astro";
import { byTag, getPosts } from "../../posts";

export async function getStaticPaths() {
  return byTag(await getPosts()).map(([tag, posts]) => ({ params: { tag }, props: { tag, posts } }));
}
const { tag, posts } = Astro.props;
---
<Base title={`#${tag} — Fearnotes`} description={`標籤為 #${tag} 的 ${posts.length} 篇文章。`}>
  <header class="head">
    <p class="mono muted enter" style="--i: 2"><a href="/tags/">tags</a> / {String(posts.length).padStart(2, "0")} entries</p>
    <h1>#{tag}</h1>
  </header>
  <PostGrid posts={posts} />
</Base>

<style>
  @layer components {
    .head { padding-block: clamp(3rem, 1rem + 7vw, 7rem) var(--space-3); }
    .head a { color: var(--color-text-muted); }
    h1 { font: 600 var(--step-4) / 1.1 var(--font-serif); letter-spacing: var(--tracking-display); color: var(--color-text-strong); margin-top: var(--space-2); overflow-wrap: anywhere; }
  }
</style>
