---
// Every tag as a card: how many posts, when it was last written in, and its three newest titles,
// so a reader can tell what a tag holds before opening it.
import Base from "../../layouts/Base.astro";
import { byTag, getPosts, postHref, tagHref, ymd } from "../../posts";

const posts = await getPosts();
const tags = byTag(posts);
---
<Base title="Tags — Fearnotes" description="依標籤瀏覽 Fearnotes 的所有文章。">
  <header class="head">
    <p class="mono muted enter" style="--i: 2">{String(tags.length).padStart(2, "0")} tags · {String(posts.length).padStart(3, "0")} entries</p>
    <h1>Tags</h1>
  </header>
  <ul class="tags">
    {tags.map(([t, list]) => (
      <li>
        <h2><a href={tagHref(t)}><span class="name">#{t}</span><span class="n mono">{String(list.length).padStart(2, "0")}</span></a></h2>
        <p class="mono muted">last write {ymd(list[0].data.date)}</p>
        <ol>
          {list.slice(0, 3).map((post) => <li><a href={postHref(post.id)}>{post.data.title}</a></li>)}
        </ol>
        {list.length > 3 && <a class="all mono" href={tagHref(t)}>全部 {list.length} 篇 →</a>}
      </li>
    ))}
  </ul>
</Base>

<style>
  @layer components {
    .head { padding-block: clamp(3rem, 1rem + 7vw, 7rem) var(--space-4); }
    h1 { font: 600 var(--step-4) / 1 var(--font-serif); letter-spacing: var(--tracking-display); color: var(--color-text-strong); margin-top: var(--space-2); }

    /* same hairline bento as the post cards */
    .tags { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1px; margin: 1px; }
    .tags > li { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3); box-shadow: 0 0 0 1px var(--color-rule); }
    h2 a { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-2); text-decoration: none; }
    .name { font: 600 var(--step-2) / 1.3 var(--font-serif); color: var(--color-text-strong); overflow-wrap: anywhere; transition: color var(--dur-1); }
    h2 a:hover .name { color: var(--color-accent); }
    .n { font-size: var(--step-1); color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
    ol { margin-top: var(--space-1); }
    ol li + li { border-top: var(--border); }
    ol a { display: block; padding-block: .55rem; color: var(--color-text); text-decoration: none; line-height: 1.5; }
    ol a:hover { color: var(--color-accent); }
    .all { margin-top: auto; padding-top: var(--space-1); color: var(--color-text-muted); text-decoration: none; }
    .all:hover { color: var(--color-accent); }
  }
</style>
