<footer class="foot mono muted rule">
  <span>© {new Date().getFullYear()} Fearnot</span>
  <ul>
    <li><a href="/rss.xml">RSS</a></li>
    <li><a href="https://github.com/fearnot221" rel="me">GitHub</a></li>
    <li><a href="https://fearnot.tw/">fearnot.tw</a></li>
  </ul>
</footer>

<style>
  @layer components {
    .foot { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: var(--space-2) var(--space-3); margin-top: var(--space-5); padding-top: var(--space-3); }
    ul { display: flex; gap: var(--space-3); }
    a { display: inline-block; padding-block: .3rem; color: var(--color-text-muted); text-decoration: none; }
    a:hover { color: var(--color-accent); }
  }
</style>
